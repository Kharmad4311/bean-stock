# Copier ce fichier en .env (ignoré par git) et renseigner les valeurs.

# Mot de passe du compte sa du conteneur SQL Server.
# Règles SQL Server : 8 caractères minimum, avec au moins 3 catégories parmi
# majuscules, minuscules, chiffres et symboles.
MSSQL_SA_PASSWORD=

# Port exposé sur la machine hôte (1433 par défaut).
# À changer si un SQL Server local utilise déjà ce port, par exemple 14333.
MSSQL_HOST_PORT=1433
